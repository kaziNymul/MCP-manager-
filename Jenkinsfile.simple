/**
 * MCP Manager - Jenkins CI/CD Pipeline (Simplified Version)
 * 
 * This is a simpler version that runs on a standard Jenkins agent with Docker installed.
 * Use this if you don't have a Kubernetes-based Jenkins setup.
 * 
 * Required Jenkins Credentials:
 *   docker-registry-credentials → Username/Password
 *   mke-kubeconfig-file        → Secret file (kubeconfig)
 * 
 * Required on Jenkins Agent:
 *   - Docker
 *   - Node.js 20+
 *   - kubectl
 */

pipeline {
    agent any

    environment {
        DOCKER_REGISTRY = 'your-registry.company.com'  // Change this
        IMAGE_TAG = "${GIT_COMMIT.take(7)}"
        SERVICES = 'admin-ui control-plane gateway registry scanner'
    }

    options {
        timeout(time: 45, unit: 'MINUTES')
        disableConcurrentBuilds()
        timestamps()
    }

    tools {
        nodejs 'NodeJS-20'  // Configure in Jenkins Global Tool Configuration
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                    npm install -g pnpm@9
                    pnpm install --frozen-lockfile
                    pnpm db:generate
                '''
            }
        }

        stage('Lint & Build') {
            steps {
                sh '''
                    pnpm lint || true
                    pnpm build
                '''
            }
        }

        stage('Build Docker Images') {
            when {
                anyOf {
                    branch 'main'
                    branch 'dev'
                }
            }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'docker-registry-credentials',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh '''
                        echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin $DOCKER_REGISTRY
                        
                        for service in $SERVICES; do
                            echo "Building $service..."
                            docker build \
                                --build-arg VERSION="${IMAGE_TAG}" \
                                -t $DOCKER_REGISTRY/mcp-manager/$service:$IMAGE_TAG \
                                -t $DOCKER_REGISTRY/mcp-manager/$service:$BRANCH_NAME \
                                -f apps/$service/Dockerfile .
                            
                            docker push $DOCKER_REGISTRY/mcp-manager/$service:$IMAGE_TAG
                            docker push $DOCKER_REGISTRY/mcp-manager/$service:$BRANCH_NAME
                        done
                    '''
                }
            }
        }

        stage('Deploy to Staging') {
            when {
                branch 'dev'
            }
            steps {
                withCredentials([file(credentialsId: 'mke-kubeconfig-file', variable: 'KUBECONFIG')]) {
                    sh '''
                        # Update kustomization
                        sed -i "s|newTag:.*|newTag: \\"${IMAGE_TAG}\\"|g" k8s/overlays/staging/kustomization.yaml
                        sed -i "s|newName:.*admin-ui|newName: ${DOCKER_REGISTRY}/mcp-manager/admin-ui|g" k8s/overlays/staging/kustomization.yaml
                        sed -i "s|newName:.*control-plane|newName: ${DOCKER_REGISTRY}/mcp-manager/control-plane|g" k8s/overlays/staging/kustomization.yaml
                        sed -i "s|newName:.*gateway|newName: ${DOCKER_REGISTRY}/mcp-manager/gateway|g" k8s/overlays/staging/kustomization.yaml
                        sed -i "s|newName:.*registry|newName: ${DOCKER_REGISTRY}/mcp-manager/registry|g" k8s/overlays/staging/kustomization.yaml
                        sed -i "s|newName:.*scanner|newName: ${DOCKER_REGISTRY}/mcp-manager/scanner|g" k8s/overlays/staging/kustomization.yaml
                        
                        kubectl create namespace mcp-manager-staging --dry-run=client -o yaml | kubectl apply -f -
                        kubectl apply -k k8s/overlays/staging
                        
                        for service in $SERVICES; do
                            kubectl rollout status deployment/$service -n mcp-manager-staging --timeout=300s || true
                        done
                        
                        kubectl get pods -n mcp-manager-staging
                    '''
                }
            }
        }

        stage('Approval') {
            when {
                branch 'main'
            }
            steps {
                input message: 'Deploy to Production?', ok: 'Deploy'
            }
        }

        stage('Deploy to Production') {
            when {
                branch 'main'
            }
            steps {
                withCredentials([file(credentialsId: 'mke-kubeconfig-file', variable: 'KUBECONFIG')]) {
                    sh '''
                        # Update kustomization
                        sed -i "s|newTag:.*|newTag: \\"${IMAGE_TAG}\\"|g" k8s/overlays/production/kustomization.yaml
                        sed -i "s|newName:.*admin-ui|newName: ${DOCKER_REGISTRY}/mcp-manager/admin-ui|g" k8s/overlays/production/kustomization.yaml
                        sed -i "s|newName:.*control-plane|newName: ${DOCKER_REGISTRY}/mcp-manager/control-plane|g" k8s/overlays/production/kustomization.yaml
                        sed -i "s|newName:.*gateway|newName: ${DOCKER_REGISTRY}/mcp-manager/gateway|g" k8s/overlays/production/kustomization.yaml
                        sed -i "s|newName:.*registry|newName: ${DOCKER_REGISTRY}/mcp-manager/registry|g" k8s/overlays/production/kustomization.yaml
                        sed -i "s|newName:.*scanner|newName: ${DOCKER_REGISTRY}/mcp-manager/scanner|g" k8s/overlays/production/kustomization.yaml
                        
                        kubectl apply -k k8s/overlays/production
                        
                        for service in $SERVICES; do
                            kubectl rollout status deployment/$service -n mcp-manager --timeout=600s
                        done
                        
                        kubectl exec deploy/control-plane -n mcp-manager -- npx prisma migrate deploy || true
                        kubectl get pods -n mcp-manager
                    '''
                }
            }
        }
    }

    post {
        always {
            sh 'docker system prune -f || true'
            cleanWs()
        }
        success {
            echo '✅ Pipeline completed successfully!'
        }
        failure {
            echo '❌ Pipeline failed!'
        }
    }
}
