# Database
DATABASE_URL=postgresql://mcp:mcp@localhost:5432/mcp_manager

# Auth - Development mode
AUTH_MODE=development
JWT_SECRET=dev-secret-change-in-production
JWT_ISSUER=mcp-manager-dev
JWT_AUDIENCE=mcp-manager

# Production Auth (uncomment and configure)
# AUTH_MODE=oidc
# JWT_ISSUER=https://your-idp.com
# JWT_AUDIENCE=mcp-manager
# JWKS_URI=https://your-idp.com/.well-known/jwks.json

# Service URLs
CONTROL_PLANE_URL=http://localhost:3001
REGISTRY_URL=http://localhost:3002
GATEWAY_URL=http://localhost:3003
SCANNER_URL=http://localhost:3004

# Service Ports
CONTROL_PLANE_PORT=3001
REGISTRY_PORT=3002
GATEWAY_PORT=3003
SCANNER_PORT=3004

# Scanner Configuration
SCANNER_INTERVAL_MS=30000
AUTO_APPROVE_THRESHOLD=30
SCAN_TIMEOUT_MS=30000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_MAX_PER_TOOL=20

# Logging
LOG_LEVEL=debug
LOG_FORMAT=pretty

# Redis (for rate limiting and caching)
REDIS_URL=redis://localhost:6379

# =============================================================================
# GitHub Copilot Enterprise Integration (Optional)
# =============================================================================
# When configured, MCP Manager will automatically sync approved servers
# to your GitHub Enterprise Copilot MCP server allowlist.
#
# SCOPE LEVEL:
# - 'enterprise': All users under enterprise (no separate orgs) - MOST COMMON
# - 'organization': Users organized into orgs within enterprise
#
# GITHUB_SCOPE_LEVEL=enterprise
#
# For ENTERPRISE level (no orgs, all users directly under enterprise):
# GITHUB_ENTERPRISE_NAME=your-enterprise-slug   # From: github.com/enterprises/YOUR-SLUG
# GITHUB_API_URL=https://github.your-company.com/api/v3  # Your GHES API URL
#
# For ORGANIZATION level (users in orgs):
# GITHUB_ORG=your-org-name
# GITHUB_API_URL=https://api.github.com  # Or your GHES URL
#
# Authentication (required for both):
# Create a GitHub App at: https://github.your-company.com/enterprises/YOUR-ENTERPRISE/settings/apps/new
# GITHUB_APP_ID=12345                   # From App settings page
# GITHUB_APP_INSTALLATION_ID=67890      # From URL after installing the App
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
# ...your private key here...
# -----END RSA PRIVATE KEY-----"
#
# Or use a PAT (Personal Access Token) - simpler but less secure:
# GITHUB_TOKEN=ghp_xxxxxxxxxxxx         # PAT with admin:enterprise or admin:org scope
#
# Auto-sync setting:
# GITHUB_AUTO_SYNC=true  # Auto-sync to GitHub on approve/revoke

